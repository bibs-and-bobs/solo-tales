{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for Solo Tales desktop window: scoped AppData filesystem saves and HTTP/keychain access.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "fs:allow-appdata-read-recursive",
    "fs:allow-appdata-write-recursive",
    "fs:allow-appdata-meta-recursive",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
